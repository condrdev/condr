# What script/build-mobile.sh builds and generates (ADR 0039).
/ios/CondrKit/condr_mobileFFI.xcframework/
/ios/CondrKit/Sources/CondrKit/condr_mobile.swift
/ios/CondrKit/.build/
/ios/CondrKit/.swiftpm/
/android/condr/src/main/jniLibs/
/android/condr/src/main/kotlin/
# xcodegen generates them from ios/project.yml.
/ios/Condr.xcodeproj/
/ios/Condr/Condr.entitlements
# Xcode writes the strings it extracts into it on every build; track it again once the app is translated.
/ios/Condr/Resources/Localizable.xcstrings
# Gradle and Android Studio.
/android/.gradle/
/android/.kotlin/
/android/.idea/
/android/local.properties
/android/**/build/
/android/app/google-services.json
