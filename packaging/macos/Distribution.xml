<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
  <title>Condr</title>
  <options customize="never" hostArchitectures="@ARCH@" />
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false" />
  <choices-outline>
    <line choice="condr" />
  </choices-outline>
  <choice id="condr" title="Condr" description="Condr GUI and CLI">
    <pkg-ref id="dev.condr.condr" />
  </choice>
  <pkg-ref id="dev.condr.condr" version="@VERSION@" onConclusion="none">condr-component.pkg</pkg-ref>
</installer-gui-script>
