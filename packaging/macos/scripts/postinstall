#!/bin/sh
set -eu

# The user-domain package's destination ($2) is the target user's home.
target_home=${2:?Installer destination is missing}
case "$target_home" in
    /*) ;;
    *) echo "Invalid installation destination: $target_home" >&2; exit 1 ;;
esac
if [ "$target_home" = / ] || [ ! -x "$target_home/.local/bin/condr" ]; then
    echo "Condr CLI is missing from the user installation: $target_home" >&2
    exit 1
fi

# Bash reads only the first existing login profile. Do not create one that
# would hide the user's existing startup configuration.
bash_profile="$target_home/.profile"
for name in .bash_profile .bash_login; do
    if [ -f "$target_home/$name" ]; then
        bash_profile="$target_home/$name"
        break
    fi
done

for profile in "$target_home/.zprofile" "$bash_profile"; do
    if ! grep -Fqx '# condr user bin' "$profile" 2>/dev/null; then
        cat >>"$profile" <<'EOF'

# condr user bin
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
    fi
done

echo 'Open a new terminal, then run: condr --help'
