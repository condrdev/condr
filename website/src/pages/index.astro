---
import { Image } from 'astro:assets';
import hero from '../../../assets/screenshots/hero.png';
import '../styles/home.css';

const features = [
  { title: 'Always on', copy: 'The Server stays on. Close the window or disconnect — your agents keep working.' },
  { title: 'Remote access', copy: 'Manage local and remote machines in one window. Connect over SSH or pair over TCP.' },
  { title: 'Agent awareness', copy: 'See every agent’s state in the sidebar. Get notified when work is done.' },
  { title: 'Agent driven', copy: 'Agents can use Condr too: create panes, read output, assign tasks, and talk to each other.' },
  { title: 'Real terminals', copy: 'Every pane is a real terminal powered by the alacritty core. Run any CLI program.' },
  { title: 'Fast by default', copy: 'Built entirely in Rust. No Electron. Responsive even while agents are busy.' },
];

const agents = [
  { name: 'Claude Code', icon: 'claude' },
  { name: 'Codex', icon: 'codex' },
  { name: 'OpenCode', icon: 'opencode' },
  { name: 'Pi', icon: 'pi' },
  { name: 'OMP', icon: 'omp' },
  { name: 'Antigravity', icon: 'antigravity' },
  { name: 'Grok', icon: 'grok' },
  { name: 'Cursor', icon: 'cursor' },
  { name: 'Copilot', icon: 'copilot' },
  { name: 'Kimi', icon: 'kimi' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Condr keeps your agents running. One window for all your agents, local or remote." />
    <link rel="icon" href="/condr.svg" />
    <title>Condr — Keep your agents running</title>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Condr home"><img src="/condr.svg" alt="" /><span>Condr</span></a>
      <div class="header-actions">
        <nav aria-label="Main navigation">
          <a href="/docs/">Docs</a>
        </nav>
        <span class="header-button is-disabled" aria-disabled="true">Coming soon</span>
      </div>
    </header>

    <main>
      <section class="hero shell">
        <h1>Keep your agents<br /><span>running.</span></h1>
        <p class="hero-lede">One window for all your agents.<br />Local or remote, step away and pick up where you left off.</p>
        <div class="hero-actions">
          <span class="button button-primary is-disabled" aria-disabled="true">Coming soon</span>
          <a class="button button-secondary" href="/docs/">Read the docs <span>→</span></a>
        </div>
        <div class="hero-meta"><span>Windows</span><i></i><span>macOS</span><i></i><span>Linux</span><i></i><span>Built in Rust</span></div>
      </section>

      <section class="product-shot shell" aria-label="Condr workspace screenshot">
        <div class="shot-halo" aria-hidden="true"></div>
        <figure><Image src={hero} alt="Condr workspace showing Claude Code, Codex, a remote dev server, and multiple terminal panes" loading="eager" widths={[640, 960, 1280, hero.width]} sizes="(max-width: 1280px) 100vw, 1280px" /><figcaption><span>One workspace</span><span>Claude Code · Codex · any CLI</span></figcaption></figure>
        <div class="agent-strip" aria-label="Supported agent CLIs">
          {agents.map((agent) => <span class="agent-item"><img src={`/agents/${agent.icon}.svg`} alt="" aria-hidden="true" />{agent.name}</span>)}
          <span class="agent-more">More...</span>
        </div>
      </section>

      <section class="features shell" id="features">
        <div class="statement">
          <p class="section-label">Everything in one window</p>
          <h2>Give every agent a place<br /><span>to work.</span></h2>
          <p class="statement-copy">Condr is a small native GUI for running Claude Code, Codex, and other CLI agents side by side. The work stays in real terminals. You get one clear view.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class="feature-card"><h3>{index + 1}. {feature.title}</h3><p>{feature.copy}</p></article>
          ))}
        </div>
      </section>

      <section class="remote shell" id="remote">
        <div class="remote-copy"><div class="section-label">Local or remote</div><h2>Leave the machine.<br /><span>Keep the work.</span></h2><p>Connect your laptop to a headless build box over SSH, or pair devices with a short-lived invite over TCP. Condr keeps the same workspace model either way.</p><a class="text-link" href="/docs/concepts/">How the connection works <span>→</span></a></div>
        <div class="connection-card">
          <div class="connection-head"><span class="connection-live"></span><span>Remote connections</span><span class="connection-count">SSH · TCP</span></div>
          <div class="remote-method">
            <div class="method-icon">↗</div>
            <strong>SSH</strong>
            <small class="method-description">Connect to a remote machine.</small>
          </div>
          <code class="remote-code">ssh://user@build-box</code>
          <div class="remote-method">
            <div class="method-icon method-tcp">⌁</div>
            <strong>TCP pairing</strong>
            <small class="method-description">Pair another Condr device.</small>
          </div>
          <code class="remote-code">tcp://&lt;server key&gt;.&lt;invite&gt;@&lt;host&gt;:&lt;port&gt;</code>
        </div>
      </section>
    </main>

    <footer class="site-footer shell"><a class="brand" href="/" aria-label="Condr home"><img src="/condr.svg" alt="" /><span>Condr</span></a><span>Keep your agents running.</span><div><a href="/docs/">Docs</a></div></footer>
  </body>
</html>
