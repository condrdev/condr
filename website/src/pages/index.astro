---
import { Image } from 'astro:assets';
import hero from '../../../assets/screenshots/hero.png';
import phoneWelcome from '../../../assets/screenshots/phone-welcome.png';
import phoneAgents from '../../../assets/screenshots/phone-agents.png';
import phoneDevice from '../../../assets/screenshots/phone-device.png';
import needsYou from '../../../assets/screenshots/needs-you.png';
import panes from '../../../assets/screenshots/panes.png';
import diff from '../../../assets/screenshots/diff.png';
import preview from '../../../assets/screenshots/preview.png';
import history from '../../../assets/screenshots/history.png';
import ports from '../../../assets/screenshots/ports.png';
import transfers from '../../../assets/screenshots/transfers.png';
import screenMain from '../../../assets/screenshots/screen-main.png';
import screenDiff from '../../../assets/screenshots/screen-diff.png';
import screenMainDiff from '../../../assets/screenshots/screen-main-diff.png';
import Site from '../layouts/Site.astro';

const phones = [
  { src: phoneWelcome, alt: "The Companion's welcome page: Every agent, within reach, and a button to pair with your computer" },
  { src: phoneAgents, alt: 'The Agents page: what each agent on macmini and jpdev needs you for, has finished or is working on' },
  { src: phoneDevice, alt: "The macmini page: its Workspaces, each agent's state and the shell beside them" },
];

// Each screenshot below comes from the app itself, rendered offscreen: see
// crates/condr-gui/src/app/screenshots/website.rs.
const features = [
  { title: 'Stays running', copy: 'Close your laptop or lose the connection, and your agents and long-running tasks carry on. Reconnect any time and pick up right where you left off.' },
  { title: 'Agent driven', copy: 'Agents can drive Condr in turn: create panes on their own, hand out tasks across panes, and talk to other agents.' },
  { title: 'Smooth', copy: 'Native from end to end, written in Rust with no Electron. Small and responsive, even while agents are busy.' },
];

// The Companion's Agents page down to the end of Needs you, in its pixels.
const phoneAgentsCrop = 1740;

const reviews = [
  { id: 'diff', name: 'Diff', copy: 'Every file an agent touched, side by side or in one column, against HEAD or against everything the branch changed since it forked.', src: diff, alt: 'The Diff Tab showing ports.rs side by side, with the Changes list of six modified files and their added and removed lines' },
  { id: 'preview', name: 'Preview', copy: 'Any file, highlighted, with the lines it changed marked beside their numbers. Edit and save it there, on a remote Device too.', src: preview, alt: 'The Preview Tab showing ports.rs with its changed lines marked beside the line numbers and on the scrollbar, next to the Files tree' },
  { id: 'history', name: 'History', copy: "The branch's commits, newest first. Pick one to see the files it changed and open each as that commit changed it.", src: history, alt: 'History listing the branch commits, one selected with its nine changed files, and the Diff Tab showing sidebar.rs as that commit changed it' },
];

const agents = [
  { name: 'Claude Code', icon: 'claude' },
  { name: 'Codex', icon: 'codex' },
  { name: 'OpenCode', icon: 'opencode' },
  { name: 'Pi', icon: 'pi' },
  { name: 'OMP', icon: 'omp' },
  { name: 'Antigravity', icon: 'antigravity' },
  { name: 'Grok', icon: 'grok' },
  { name: 'Cursor', icon: 'cursor' },
  { name: 'Copilot', icon: 'copilot' },
  { name: 'Kimi', icon: 'kimi' },
];

const methods = [
  { name: 'SSH', copy: 'For remote servers or cloud hosts you already reach with OpenSSH. Reuses your existing configuration as is.', address: 'ssh://user@192.168.1.100' },
  { name: 'P2P', copy: "For networks where both sides sit behind NAT or a firewall with no public IP. Connects directly through hole punching when it can, or through an encrypted relay when it can't.", address: 'p2p://<device key>.<invite>' },
  { name: 'TCP', copy: 'For servers with a fixed IP or reachable directly on the LAN. All traffic is end-to-end encrypted with <code>Noise_IKpsk2</code>.', address: 'tcp://<device key>.<invite>@<host>:<port>' },
];
---

<Site title="Condr — Agents that never hang up" description="One window for every agent, local and remote. Native apps for Windows, macOS and Linux, and a mobile app for iPhone and Android.">
  <section class="hero shell">
    <canvas class="hero-mark" aria-hidden="true"></canvas>
    <h1>Agents that<br />never<br />hang up.</h1>
    <div class="hero-side">
      <p class="hero-lede">One window for every agent, local and remote. Disconnect anytime, pick up where you left off.</p>
      <p class="hero-meta">Windows, macOS and Linux. Built in Rust.</p>
      <div class="actions">
        <a class="button" href="/download/" data-download>Download</a>
        <a class="text-link" href="/docs/start/getting-started/">Get started</a>
      </div>
    </div>
    <div class="hero-switch" role="radiogroup" aria-label="Screenshots of">
      <label><input type="radio" name="shot" id="shot-desktop" checked /><span>Desktop</span></label>
      <label><input type="radio" name="shot" id="shot-mobile" /><span>Mobile <small class="badge">Early preview</small></span></label>
    </div>
    <figure class="hero-shot hero-shot-desktop">
      <Image src={hero} alt="Condr with one local and two remote Devices: Needs you lists two agents waiting on build-box and gpu-box, Claude Code, Codex and lazygit share a Tab, and Files shows the project tree" loading="eager" widths={[640, 960, 1280, 1920, 2560, hero.width]} sizes="(max-width: 1280px) 100vw, 1280px" />
    </figure>
    <figure class="hero-shot hero-shot-mobile">
      {phones.map((phone) => <Image src={phone.src} alt={phone.alt} loading="lazy" widths={[400, 800, phone.src.width]} sizes="(max-width: 760px) 72vw, 340px" />)}
    </figure>
  </section>

  <section class="row shell" aria-labelledby="agents-title">
    <h2 class="row-title" id="agents-title">Runs any CLI agent</h2>
    <ul class="agents">
      {agents.map((agent) => <li><img src={`/agents/${agent.icon}.svg`} alt="" />{agent.name}</li>)}
      <li class="agents-more">and any other terminal program</li>
    </ul>
  </section>

  <section class="row shell" aria-labelledby="features-title">
    <h2 id="features-title">Give every agent a place to work.</h2>
    <p class="row-copy">Condr is a lightweight app built for running many agents together and managing their terminals. Run Claude Code, Codex and any command-line program side by side in one window, on your own machine or on a remote server.</p>
    <article class="showcase">
      <div class="showcase-text">
        <h3>Know which agent needs you</h3>
        <p>The sidebar shows what every agent on every Device is doing. <strong>Needs you</strong> lists the ones waiting for your approval or stopped on an error, with what they said, and Condr notifies you when one finishes. The Companion carries the same list in your pocket.</p>
      </div>
      <div class="shots">
        <figure style={`flex-grow: ${(100 * needsYou.width) / needsYou.height}`}>
          <Image src={needsYou} alt="The left sidebar: Needs you lists a Claude Code agent on build-box waiting to run pnpm test and one on gpu-box stopped on an API error, above the Workspaces and agents of this machine and build-box" widths={[300, needsYou.width]} sizes="(max-width: 760px) 40vw, 320px" />
        </figure>
        <figure class="crop" style={`flex-grow: ${(100 * phoneAgents.width) / phoneAgentsCrop}; aspect-ratio: ${phoneAgents.width} / ${phoneAgentsCrop}`}>
          <Image src={phoneAgents} alt="The Companion's Agents page: the two agents that need you, one waiting to run cargo test and one asking which chart library to use" widths={[400, 800]} sizes="(max-width: 760px) 50vw, 420px" />
        </figure>
      </div>
    </article>

    <article class="showcase showcase-flip">
      <div class="showcase-text">
        <h3>Every agent in its own pane</h3>
        <p>Split a Tab as far as you like and run Claude Code, Codex or any other program in each Pane. Real terminals built on Ghostty's terminal core keep every TUI working, and a screenshot pastes into an agent on another machine in one step.</p>
      </div>
      <div class="shots">
        <figure>
          <Image src={panes} alt="One Tab split three ways: Claude Code on the left, Codex top right and lazygit bottom right, all in the same worktree" widths={[640, 960, 1280, panes.width]} sizes="(max-width: 760px) 100vw, 850px" />
        </figure>
      </div>
    </article>

    <article class="showcase showcase-wide">
      <div class="showcase-text">
        <h3>One screen is not enough</h3>
        <p>Open a Tab, a Workspace or a whole Device in a window of its own, from its menu or by dragging it out, and move it to another display.</p>
      </div>
      <!-- The Diff Tab leaves the main window for a second display and comes back (home.css, "Desk"). -->
      <figure class="desk" aria-label="The Diff Tab leaves the main window for a window of its own on a second display, then comes back">
        {[0, 1].map((i) => (
          <div class={`monitor monitor-${i ? 'b' : 'a'}`}>
            <div class="panel">
              <div class="display">
                {i === 0 && <Image class="shot" src={screenMain} alt="The main window: Claude Code, Codex and lazygit share a Tab beside the Changes list" widths={[640, 1080, 1280]} sizes="(max-width: 760px) 45vw, 540px" />}
                {i === 0 && <Image class="shot shot-before" src={screenMainDiff} alt="" widths={[640, 1080, 1280]} sizes="(max-width: 760px) 45vw, 540px" />}
              </div>
            </div>
            <div class="neck"></div>
            <div class="foot"></div>
          </div>
        ))}
        <Image class="window" src={screenDiff} alt="The Diff Tab in a window of its own on the second display, showing ports.rs side by side, with Bring Back in its title bar" widths={[640, 1080, 1280]} sizes="(max-width: 760px) 45vw, 540px" />
      </figure>
    </article>

    <div class="features">
      {features.map((feature) => <article><h3>{feature.title}</h3><p>{feature.copy}</p></article>)}
    </div>
  </section>

  <section class="row shell" aria-labelledby="review-title">
    <h2 id="review-title">Read what they changed.</h2>
    <p class="row-copy">Changes, Diff, Preview and History sit right beside the terminals, so you check an agent's work on the machine it ran on, local or remote, without opening another app.</p>
    <div class="review">
      <div class="review-list" role="radiogroup" aria-label="Review views">
        {reviews.map((review, i) => (
          <label>
            <input type="radio" name="review" id={`review-${review.id}`} checked={i === 0} />
            <span class="review-item"><b>{review.name}</b><span class="review-copy"><span>{review.copy}</span></span></span>
          </label>
        ))}
      </div>
      <div class="review-shots">
        {reviews.map((review) => (
          <figure class={`review-shot review-shot-${review.id}`}>
            <Image src={review.src} alt={review.alt} widths={[640, 960, 1280, 1700, review.src.width]} sizes="(max-width: 760px) 100vw, 850px" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="row shell" aria-labelledby="remote-title">
    <h2 id="remote-title">Leave the machine. Keep the work.</h2>
    <div class="row-copy">
      <p>Condr manages every agent task, local and remote, across machines from a single window. Running the work on a remote server frees your agents from the limits of your local workstation, so they keep going through reboots and network drops.</p>
      <a class="text-link" href="/docs/using/remote/">Set up a remote connection</a>
    </div>
    <div class="shots remote-shots">
      <figure style={`flex-grow: ${(100 * ports.width) / ports.height}`}>
        <Image src={ports} alt="The Ports page forwarding 5173 and 8080 from build-box and 6006 from gpu-box to localhost on this machine" widths={[640, 980, ports.width]} sizes="(max-width: 760px) 100vw, 980px" />
        <figcaption>A dev server an agent started on a remote Device, at localhost here.</figcaption>
      </figure>
      <figure style={`flex-grow: ${(100 * transfers.width) / transfers.height}`}>
        <Image src={transfers} alt="Files of a remote Workspace with two uploads done, a download under way and an upload waiting" widths={[320, transfers.width]} sizes="(max-width: 760px) 60vw, 290px" />
        <figcaption>Files dropped in, downloaded with a click.</figcaption>
      </figure>
    </div>
    <dl class="methods">
      {methods.map((method) => <div><dt>{method.name}</dt><dd set:html={method.copy} /><dd><code>{method.address}</code></dd></div>)}
    </dl>
  </section>

  <section class="row closing shell" aria-labelledby="start-title">
    <h2 id="start-title">Try it in 30 seconds.</h2>
    <div class="actions">
      <a class="button" href="/download/" data-download>Download</a>
      <a class="text-link" href="/docs/start/getting-started/">Get started</a>
    </div>
  </section>

  <script is:inline>
    // Inline so the buttons name the visitor's platform before the first paint.
    {
      const os = document.documentElement.dataset.os;
      const name = { macos: "macOS", windows: "Windows", linux: "Linux", ios: "iOS", android: "Android" }[os];
      if (name) for (const a of document.querySelectorAll("[data-download]")) a.textContent = `Download for ${name}`;
    }
  </script>

  <script>
    // Scroll reveal: what scrolls into view arrives once, each kind its own way (home.css, "Scroll
    // reveal"): big headings set in line by line, the rules of the grid draw from the left with their
    // words following, screenshots resolve out of the logo's dot matrix. What enters together arrives
    // in reading order. Content stays visible without this script, what is on screen when it runs
    // stays put, and reduced motion skips it all.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const kinds: [string, string][] = [
        [".row:not(.closing) > h2", "type"],
        [".row-copy, .agents li, .review-list label", "rise"],
        [".row-title, .showcase-text, .features article, .methods > div, .closing", "rule"],
        [".hero-shot, .shots figure, .review-shots", "dots"],
      ];
      for (const [selector, kind] of kinds)
        for (const el of document.querySelectorAll<HTMLElement>(selector))
          // The hidden hero screenshot is left alone: it would wait unseen for a reveal that never comes.
          if (el.offsetParent) el.dataset.reveal = kind;
      const targets = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
      const line = innerHeight * 0.88;
      // Back to plain markup once the longest arrival is over, so nothing lingers on the page.
      const settle = (el: HTMLElement, delay: number) =>
        setTimeout(() => {
          el.classList.remove("in");
          delete el.dataset.reveal;
          el.style.removeProperty("--delay");
        }, delay + 1400);
      const observer = new IntersectionObserver(
        (entries) => {
          const arriving = entries
            .filter((entry) => entry.isIntersecting)
            .map((entry) => entry.target as HTMLElement)
            .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top || a.getBoundingClientRect().left - b.getBoundingClientRect().left);
          // A step of 70ms, shortened so a long list still lands within half a second.
          const step = Math.min(70, 480 / Math.max(arriving.length - 1, 1));
          arriving.forEach((el, i) => {
            observer.unobserve(el);
            el.style.setProperty("--delay", `${Math.round(i * step)}ms`);
            el.classList.add("in");
            settle(el, i * step);
          });
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      for (const el of targets) {
        // Already on screen: left as it is, since the dots would play even without a transition.
        if (el.getBoundingClientRect().top < line) delete el.dataset.reveal;
        else observer.observe(el);
      }
      // Last, so what is already on screen never takes its hidden state.
      document.documentElement.classList.add("reveal-ready");
    }

    // The desk plays only while it can be seen.
    {
      const desk = document.querySelector<HTMLElement>(".desk")!;
      new IntersectionObserver(([entry]) => desk.classList.toggle("playing", entry.isIntersecting), { threshold: 0.35 }).observe(desk);
    }

    // Switching the hero's screenshots dissolves one into the dot matrix the logo is drawn on and
    // resolves the other out of it (home.css, ::view-transition-*(hero-shot)). Without View
    // Transitions, or with reduced motion, the radios switch on their own as before.
    {
      const hero = document.querySelector<HTMLElement>(".hero")!;
      const images = (input: HTMLInputElement) =>
        hero.querySelectorAll<HTMLImageElement>(input.id === "shot-mobile" ? ".hero-shot-mobile img" : ".hero-shot-desktop img");
      // The hidden screenshots load lazily; fetch them as soon as the visitor reaches for the switch.
      const fetchAll = () => hero.querySelectorAll<HTMLImageElement>(".hero-shot img").forEach((img) => (img.loading = "eager"));
      const tabs = hero.querySelector<HTMLElement>(".hero-switch")!;
      tabs.addEventListener("pointerenter", fetchAll, { once: true });
      tabs.addEventListener("focusin", fetchAll, { once: true });
      let current = tabs.querySelector<HTMLInputElement>("input:checked")!;
      tabs.addEventListener("change", (event) => {
        const next = event.target as HTMLInputElement;
        const previous = current;
        current = next;
        if (!document.startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        // The snapshot of the old state is taken after this handler, so show that state once more.
        previous.checked = true;
        document.startViewTransition(async () => {
          next.checked = true;
          await Promise.all([...images(next)].map((img) => img.decode().catch(() => {})));
        });
      });
    }

    // The logo on a dot matrix. On load the C's dots light up along its stroke and merge once into the
    // three bars of assets/brand/condr.svg. The lit C then rests while stray dots twinkle around it, and
    // every 10 seconds plays the next of a few transitions. Dots near the pointer light up in the accent
    // blue. Coordinates are that SVG's 128-unit viewBox with a dot every 4 units, so each 12-unit bar is
    // exactly 3 dots thick.
    const BARS = [
      { x: 48, y: 24, w: 42, h: 12 },
      { x: 35.5, y: 36, w: 12, h: 56 },
      { x: 48, y: 92, w: 42, h: 12 },
    ];
    const R_OFF = 0.9;
    const R_ON = 1.5;
    const INTRO = 5.2; // seconds
    const PERIOD = 10;
    const REST = 6; // seconds of each period before its transition
    // "merge" closes the dots up into the bars and opens them again; the others send a wave through the
    // C that turns each dot off and back on, in the order the name says.
    const TRANSITIONS = ["scan", "merge", "ripple", "random", "merge", "trace"] as const;

    // Each dot of the C, how far along the stroke it lies (top right, left, bottom right) and the slice
    // of its bar it grows into.
    const dots = BARS.flatMap((b, i) => {
      const centres = (from: number, size: number) =>
        Array.from({ length: 32 }, (_, k) => 2 + 4 * k).filter((v) => v > from && v < from + size);
      const xs = centres(b.x, b.w);
      const ys = centres(b.y, b.h);
      const w = b.w / xs.length;
      const h = b.h / ys.length;
      return xs.flatMap((cx, ix) =>
        ys.map((cy, iy) => ({
          cx,
          cy,
          trace: (i === 0 ? 90 - cx : i === 1 ? 48.5 + cy - 36 : 63 + cx) / 153,
          tile: { x: b.x + ix * w, y: b.y + iy * h, w, h },
        })),
      );
    });
    type Dot = (typeof dots)[number];
    const inBars = (x: number, y: number) => BARS.some((b) => x > b.x && x < b.x + b.w && y > b.y && y < b.y + b.h);

    const clamp = (v: number) => Math.min(Math.max(v, 0), 1);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => ((t = clamp(t)) < 0.5 ? 4 * t ** 3 : 1 - (2 - 2 * t) ** 3 / 2);
    // A damped spring (stiffness 170, damping 11) that overshoots by about a fifth.
    const spring = (t: number) => (t <= 0 ? 0 : 1 - Math.exp(-5.5 * t) * (Math.cos(11.8 * t) + 0.465 * Math.sin(11.8 * t)));
    // A repeatable pseudo-random number in [0, 1).
    const hash = (n: number) => {
      const x = Math.sin(n) * 43758.5453;
      return x - Math.floor(x);
    };
    // Each transition's wave order, from 0 to 1. Period `c` reshuffles the random one.
    const order = {
      scan: (d: Dot) => (d.cy - 24) / 80,
      ripple: (d: Dot) => Math.hypot(d.cx - 62.75, d.cy - 64) / 45,
      random: (d: Dot, c: number) => hash(d.cx * 131 + d.cy + c * 7919),
      trace: (d: Dot) => d.trace,
    };

    const canvas = document.querySelector<HTMLCanvasElement>(".hero-mark")!;
    const ctx = canvas.getContext("2d")!;
    const grid = document.createElement("canvas");
    const ink = getComputedStyle(canvas).color;
    const accent = getComputedStyle(document.documentElement).getPropertyValue("--accent").trim();
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hover = { x: 0, y: 0, tx: 0, ty: 0, inside: false, a: 0 };
    let sparks: { x: number; y: number; a: number }[] = [];
    let twinklers: typeof sparks = [];
    let W = 0;
    let H = 0;
    let u = 0;
    let bars = new Path2D();
    let t0: number | undefined;
    // Seconds since the first frame.
    const time = (now: number) => (now - (t0 ??= now)) / 1000;
    // Logo units to canvas pixels, with the C in the middle.
    const X = (x: number) => W / 2 + (x - 62.75) * u;
    const Y = (y: number) => H / 2 + (y - 64) * u;
    const dot = (c: CanvasRenderingContext2D, x: number, y: number, r: number) => {
      c.beginPath();
      c.arc(x, y, r, 0, 2 * Math.PI);
      c.fill();
    };

    const draw = (T: number) => {
      if (!u) return;
      let merge = 0;
      let on: (d: Dot) => number = () => 1;
      if (T < INTRO) {
        merge = ease((T - 3) / 0.6) - ease((T - 4.6) / 0.6);
        on = (d) => spring(T - 0.3 - d.trace * 1.2);
      } else {
        const c = Math.floor((T - INTRO) / PERIOD);
        const s = ((T - INTRO) % PERIOD) - REST;
        const kind = TRANSITIONS[c % TRANSITIONS.length];
        if (kind === "merge") merge = ease(s / 0.6) - ease((s - 1.6) / 0.6);
        else
          on = (d) => {
            const t = s - order[kind](d, c) * 1.2;
            return 1 - ease(t / 0.25) + spring(t - 0.45);
          };
      }

      ctx.clearRect(0, 0, W, H);
      ctx.globalAlpha = 1;
      ctx.drawImage(grid, 0, 0, W, H);
      // A stray dot starts to twinkle every 0.4 seconds and fades out over 1.8, so four or five are lit at once.
      ctx.fillStyle = ink;
      for (let k = Math.floor((T - 1.8) / 0.4) - 1; k * 0.4 <= T; k++) {
        const age = T - (k + hash(k)) * 0.4;
        if (age < 0 || age > 1.8) continue;
        const f = twinklers[Math.floor(hash(k + 0.5) * twinklers.length)];
        ctx.globalAlpha = 0.7 * f.a * Math.min(age / 0.3, (1.8 - age) / 1.5);
        dot(ctx, f.x, f.y, R_OFF * u);
      }
      if (hover.a > 0.01) {
        ctx.fillStyle = accent;
        for (const f of sparks) {
          const k = 1 - Math.hypot(f.x - hover.x, f.y - hover.y) / (28 * u);
          if (k <= 0) continue;
          ctx.globalAlpha = 0.8 * hover.a * f.a * k * k;
          dot(ctx, f.x, f.y, R_OFF * u * (1 + 0.5 * k));
        }
      }
      ctx.fillStyle = ink;
      // The solid bars come in under the tiles as they close up, hiding the seams between them.
      ctx.globalAlpha = clamp((merge - 0.85) / 0.15);
      ctx.fill(bars);
      ctx.save();
      ctx.clip(bars);
      for (const d of dots) {
        const o = on(d);
        const r = lerp(R_OFF, R_ON, o);
        ctx.globalAlpha = clamp(o);
        ctx.beginPath();
        ctx.roundRect(
          X(lerp(d.cx - r, d.tile.x, merge)),
          Y(lerp(d.cy - r, d.tile.y, merge)),
          lerp(2 * r, d.tile.w, merge) * u,
          lerp(2 * r, d.tile.h, merge) * u,
          lerp(r, 0, merge) * u,
        );
        ctx.fill();
      }
      ctx.restore();
    };

    new ResizeObserver(() => {
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      if (!W || !H) return;
      for (const c of [canvas, grid]) {
        c.width = Math.round(W * devicePixelRatio);
        c.height = Math.round(H * devicePixelRatio);
        c.getContext("2d")!.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      }
      // The C takes 70% of the height.
      u = (0.7 * H) / 80;
      bars = new Path2D();
      for (const b of BARS) bars.roundRect(X(b.x), Y(b.y), b.w * u, b.h * u, 2 * u);
      // The unlit matrix, fading out towards the edges. Every dot outside the C can light up on its own.
      const g = grid.getContext("2d")!;
      g.fillStyle = "rgb(177 198 255)";
      sparks = [];
      for (let x = 2 + 4 * Math.ceil((60.75 - W / 2 / u) / 4); X(x) < W; x += 4) {
        for (let y = 2 + 4 * Math.ceil((62 - H / 2 / u) / 4); Y(y) < H; y += 4) {
          const a = clamp((1 - Math.hypot((X(x) / W) * 2 - 1, (Y(y) / H) * 2 - 1)) / 0.4);
          g.globalAlpha = 0.16 * a;
          dot(g, X(x), Y(y), R_OFF * u);
          if (!inBars(x, y)) sparks.push({ x: X(x), y: Y(y), a });
        }
      }
      // Twinkles stay where the matrix is clearly visible, so none is lost in the faded edge.
      twinklers = sparks.filter((f) => f.a > 0.5);
      draw(still ? INTRO + 1 : time(performance.now()));
    }).observe(canvas);

    // Animate only while the canvas is on screen; with reduced motion it stays on the lit C.
    let raf = 0;
    const loop = (now: number) => {
      hover.a = lerp(hover.a, hover.inside ? 1 : 0, 0.08);
      hover.x = lerp(hover.x, hover.tx, 0.25);
      hover.y = lerp(hover.y, hover.ty, 0.25);
      draw(time(now));
      raf = requestAnimationFrame(loop);
    };
    if (!still) {
      addEventListener("pointermove", (e) => {
        const r = canvas.getBoundingClientRect();
        hover.tx = e.clientX - r.left;
        hover.ty = e.clientY - r.top;
        hover.inside = hover.tx >= 0 && hover.ty >= 0 && hover.tx <= W && hover.ty <= H;
      });
      document.documentElement.addEventListener("pointerleave", () => (hover.inside = false));
      new IntersectionObserver(([entry]) => {
        cancelAnimationFrame(raf);
        if (entry.isIntersecting) raf = requestAnimationFrame(loop);
      }).observe(canvas);
    }
  </script>
</Site>
