{
  "condr": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "condr agent-hook antigravity prompt-submit",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook antigravity tool-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook antigravity tool-complete",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "condr agent-hook antigravity stop",
        "timeout": 5
      }
    ]
  }
}
