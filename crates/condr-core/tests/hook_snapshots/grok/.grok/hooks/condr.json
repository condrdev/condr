{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok tool-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok tool-complete",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok tool-complete",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok permission-request",
            "timeout": 5
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok stop",
            "timeout": 5
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok stop",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok stop-failure",
            "timeout": 5
          }
        ]
      }
    ],
    "StopCancelled": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "condr agent-hook grok interrupt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
